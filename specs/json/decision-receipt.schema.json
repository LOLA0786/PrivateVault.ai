{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionReceipt",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "decision_id",
    "status"
  ],
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "capability": {
      "type": "object"
    },
    "loop_snapshot": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    }
  }
}
